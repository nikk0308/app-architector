# Copy this file to:
# /opt/docker-stacks/apparchitector.dev/.runtime.env
# on the server. Never commit the real file.

NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGIN=https://apparchitector.dev

API_REQUEST_TIMEOUT_MS=360000
REQUEST_BODY_LIMIT_BYTES=1048576
GENERATOR_TIMEOUT_MS=360000
STORAGE_RETENTION_DAYS=14

# Keep AI modes disabled until the corresponding credentials are configured.
LLM_ENABLED=false
ENABLE_LLM_ENRICHMENT=false
STRICT_AI_MODE_FAILURES=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
HF_ENDPOINT=
HF_PROVIDER=nscale
HF_PROVIDER_SEQUENCE=
LLM_TIMEOUT_MS=300000
LLM_MAX_NEW_TOKENS=14000
