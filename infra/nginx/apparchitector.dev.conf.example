server {
    listen 80;
    listen [::]:80;
    server_name apparchitector.dev www.apparchitector.dev;
    return 301 https://apparchitector.dev$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name apparchitector.dev;

    ssl_certificate /etc/letsencrypt/live/apparchitector.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/apparchitector.dev/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 430s;
        proxy_send_timeout 430s;
        proxy_buffering off;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.apparchitector.dev;

    ssl_certificate /etc/letsencrypt/live/apparchitector.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/apparchitector.dev/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://apparchitector.dev$request_uri;
}
